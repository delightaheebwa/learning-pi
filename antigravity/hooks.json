{
  "learning-write-guard": {
    "PreToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f ./.agents/scripts/pre_tool_gate.py ] && python3 ./.agents/scripts/pre_tool_gate.py || python3 ./scripts/pre_tool_gate.py",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "learning-turn-gate": {
    "Stop": [
      {
        "type": "command",
        "command": "[ -f ./.agents/scripts/stop_gate.py ] && python3 ./.agents/scripts/stop_gate.py || python3 ./scripts/stop_gate.py",
        "timeout": 15
      }
    ]
  }
}
