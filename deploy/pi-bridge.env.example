# ~/.config/pi-bridge.env — environment for the pi-bridge systemd --user unit.
#
#   cp pi-bridge.env.example ~/.config/pi-bridge.env
#   $EDITOR ~/.config/pi-bridge.env && chmod 600 ~/.config/pi-bridge.env
#
# EnvironmentFile does NOT expand ~ or $VAR, so use absolute paths and plain
# values. Keep this file mode 600 — it holds the bridge key.

# The bridge refuses to start without a key. Use a long random string:
#   openssl rand -hex 32
# The dockerized Open WebUI must use the SAME value (deploy/.env PI_BRIDGE_API_KEY).
PI_BRIDGE_API_KEY=replace-with-a-long-random-string

# Bind to Docker's default bridge gateway so the Open WebUI container can reach
# it (via host.docker.internal) while the LAN cannot. This is docker0, normally
# 172.17.0.1; verify with `ip -4 addr show docker0` and update if different.
PI_BRIDGE_HOST=172.17.0.1
PI_BRIDGE_PORT=8790

# The unit's ExecStartPre gate waits for PI_BRIDGE_HOST to exist, because docker0
# appears a moment after the system Docker daemon starts (the --user session can
# start first). It polls once a second for up to this many seconds, then exits so
# systemd retries. Default: 60.
#PI_BRIDGE_WAIT_TIMEOUT=60

# Where the learning system's state repo lives (absolute path):
PI_BRIDGE_STATE_REPO=/home/YOUR_USER/learning-system

# Model aliases Open WebUI can pick from. "learning" is the default choice.
PI_BRIDGE_MODELS=learning,learning-tutor,learning-review,learning-teach,learning-ingest

# Math authoring. The bridge defaults this to "latex" for its pi sessions
# because Open WebUI renders LaTeX with KaTeX/MathJax, even though headless pi
# has no terminal image protocol. Normally leave it unset; set "unicode" for a
# text-only client, or "auto" to fall back to terminal detection.
#PI_MATH_MODE=unicode

# Tuning (optional):
# Idle budget: the longest pi may stay silent mid-turn before the bridge aborts
# it. Resets on every record, so a 15-minute scout subagent is fine.
#PI_BRIDGE_TIMEOUT=1800
# Absolute ceiling for one turn, even while records keep arriving.
#PI_BRIDGE_MAX_TURN=7200
#PI_BRIDGE_MAX_SESSIONS=8
#PI_BRIDGE_PI_BIN=/home/YOUR_USER/learning-pi/bin/pi
#PI_BRIDGE_AGENT_DIR=/home/YOUR_USER/.pi/agent
#PI_BRIDGE_SESSION_DIR=/home/YOUR_USER/.pi/agent/sessions
#PI_BRIDGE_LEDGER_DIR=/home/YOUR_USER/.pi/agent/learning-gate

# Intelligent-UI widgets (optional): deliver a verified ```openui payload as an
# interactive embed below the prose. The bridge POSTs to Open WebUI's REST API,
# so it needs the Open WebUI base URL and a USER API key (Settings -> Account ->
# API Keys) in a mode-600 file. Leave the base URL unset to disable widgets.
# The same client mirrors chat delete/fork into pi; without it those actions
# keep the bridge's fallback behaviour (fresh fork, session left behind).
#PI_BRIDGE_OPENWEBUI_BASE_URL=http://127.0.0.1:3000
#PI_BRIDGE_OPENWEBUI_KEY_FILE=/home/YOUR_USER/.openwebui_key

# Seconds between Open WebUI chat delete sweeps; 0 disables the sweep. The sweep
# proves the API key first, then treats a per-chat 401/404/422 as a deleted chat.
#PI_BRIDGE_SYNC_INTERVAL=60

# Treat a streaming client disconnect (Open WebUI Stop, or leaving the chat) as
# an abort: pi stops the turn instead of running it to completion. Set false to
# keep the old consume-to-settlement behavior.
#PI_BRIDGE_ABORT_ON_DISCONNECT=true
