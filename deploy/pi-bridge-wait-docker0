#!/bin/sh
# Wait for Docker's default bridge gateway before pi-bridge binds it.
#
# pi-bridge binds PI_BRIDGE_HOST (default 172.17.0.1, i.e. docker0) so the Open
# WebUI container can reach it. The systemd --user session can start before the
# system-level Docker daemon has created docker0, and binding an address that
# does not exist yet fails with:
#   OSError: [Errno 99] Cannot assign requested address
# This pre-start gate waits for the address instead of racing it.
set -u

host="${PI_BRIDGE_HOST:-172.17.0.1}"
timeout="${PI_BRIDGE_WAIT_TIMEOUT:-60}"
deadline=$(( $(date +%s) + timeout ))

while :; do
	if ip -4 -o addr show 2>/dev/null | grep -qF "inet ${host}/"; then
		echo "pi-bridge: ${host} is available" >&2
		exit 0
	fi
	if [ "$(date +%s)" -ge "$deadline" ]; then
		echo "pi-bridge: ${host} not available after ${timeout}s; is Docker running?" >&2
		exit 1
	fi
	sleep 0.5
done
