# deploy/.env — secrets for the Open WebUI stack.
#
#   cp .env.example .env && $EDITOR .env && chmod 600 .env
#
# NEVER commit the real .env (it is git-ignored). This example has no secrets.

# Shared secret between the dockerized Open WebUI and the host pi-bridge.
# The bridge reads the SAME value from ~/.config/pi-bridge.env
# (or ~/.pi-bridge-key). Generate with:  openssl rand -hex 32
PI_BRIDGE_API_KEY=replace-with-a-long-random-string

# Signs Open WebUI sessions. Rotating it logs every user out.
# Generate with:  openssl rand -hex 32
WEBUI_SECRET_KEY=replace-with-another-long-random-string

# Only needed when using the optional searxng service: docker compose --profile search
# Generate with:  openssl rand -hex 32
SEARXNG_SECRET=replace-with-a-third-long-random-string

# --- optional overrides -----------------------------------------------------
# Browser URL for links/callbacks (loopback is fine for local use):
#WEBUI_URL=http://127.0.0.1:3000
# Leave signup ON only until the first admin account exists, then set false:
#ENABLE_SIGNUP=true
# Base URL of the bridge as seen from inside the container:
#OPENAI_API_BASE_URL=http://host.docker.internal:8790/v1
# Turn on searxng web search (also start the search profile):
#ENABLE_RAG_WEB_SEARCH=false
