#!/usr/bin/env bash
#
# pi-review-status — report whether the day's spaced-repetition /review is done.
#
# The review day is the calendar date. review-clerk names the session note with
# the date the session ran, so a review finished at 1am counts as *that* day's
# review (not the previous day's). This helper therefore reports on today's
# calendar date; there is no "logical day" shift.
#
# A successful /review writes one Session note named
#   Session — ...Review — YYYY-MM-DD.md
# so that filename (not mtime) is the completion signal.
#
# Usage:
#   pi-review-status --json          (default) one JSON object on stdout:
#     {"date":"YYYY-MM-DD","done":true|false,"visible":true|false,"missed":true|false}
#   pi-review-status --check DATE    exit 0 if a review exists for DATE, else 1
#
#   visible: the evening window (18:00-03:59) when the bar indicator shows.
#   missed:  today's review is not done and it is already late (hour >= 23).
#
# Test hooks:
#   LEARNING_SYSTEM_ROOT=/path     override checkout location
#   REVIEW_STATUS_DATE=YYYY-MM-DD  override "today"
#   REVIEW_STATUS_NOW=HH[:MM]      override the clock's time-of-day
#
set -euo pipefail

ROOT="${LEARNING_SYSTEM_ROOT:-$HOME/learning-system}"
SESSIONS="$ROOT/Learning System/Sessions"

# --- today + time-of-day (overridable for tests) -----------------------------
if [[ -n "${REVIEW_STATUS_DATE:-}" ]]; then
  today="$REVIEW_STATUS_DATE"
else
  today="$(date +%F)"
fi
if [[ ! "$today" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]; then
  echo "pi-review-status: bad date '$today' (want YYYY-MM-DD)" >&2
  exit 2
fi

if [[ -n "${REVIEW_STATUS_NOW:-}" ]]; then
  hour=$((10#${REVIEW_STATUS_NOW%%:*}))
else
  hour=$((10#$(date +%H)))
fi
if (( hour < 0 || hour > 23 )); then
  echo "pi-review-status: bad time '$REVIEW_STATUS_NOW'" >&2
  exit 2
fi

# --- does the day's review session note exist? -------------------------------
review_done() {
  local date=$1
  [[ -d "$SESSIONS" ]] || return 1
  if find "$SESSIONS" -maxdepth 1 -type f -name "Session*Review*${date}.md" -print -quit 2>/dev/null | grep -q .; then
    return 0
  fi
  return 1
}

# --- --check DATE: machine-friendly exit status ------------------------------
if [[ "${1:-}" == "--check" ]]; then
  target="${2:?pi-review-status --check requires a date (YYYY-MM-DD)}"
  if [[ ! "$target" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]; then
    echo "pi-review-status: bad date '$target' (want YYYY-MM-DD)" >&2
    exit 2
  fi
  if review_done "$target"; then
    exit 0
  else
    exit 1
  fi
fi

# --- default: JSON status ----------------------------------------------------
done=false
if review_done "$today"; then done=true; fi

visible=false
if (( hour >= 18 || hour < 4 )); then visible=true; fi

missed=false
if [[ "$done" == false ]] && (( hour >= 23 )); then missed=true; fi

printf '{"date":"%s","done":%s,"visible":%s,"missed":%s}\n' "$today" "$done" "$visible" "$missed"
