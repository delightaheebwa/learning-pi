{
  "id": "review-smoke",
  "tier": "smoke",
  "flow": "review",
  "description": "/review entry: review-scout builds the queue and the first verified turn renders",
  "steps": [
    { "prompt": "/review" }
  ],
  "until_agents": ["review-scout"],
  "until_min_messages": 1,
  "until_clean_turn": true,
  "timeout_sec": 360,
  "max_turns": 20,
  "expect": {
    "agents": ["review-scout"],
    "forbid": ["NO_REVIEW_CONTEXT", "⛔ WITHHELD", "⛔ UNVERIFIED"]
  }
}
