#!/usr/bin/env python3
"""Fail when a current doc or prompt names a retired path or a stale contract number."""
from pathlib import Path
import sys

ROOT = Path(__file__).resolve().parent.parent

CURRENT = [
    "README.md", "FIELD-GUIDE.md", "CONTRACT.md", "docs/README.md",
    "docs/teaching-methodology.md", "bridge/README.md", "deploy/README.md",
    "deploy/SECURITY.md", "harness/README.md", "bin/README.md",
    "antigravity/README.md", "omarchy/README.md", "state/README.md",
]
for base in (".pi", "antigravity/skills", "opencode/skills"):
    CURRENT += sorted(
        str(p.relative_to(ROOT)) for p in (ROOT / base).rglob("*.md")
    )

BANNED = (
    "~/learning-system",
    "bridge/genui.py",
    "v12, 72",
    "72 invariants",
    "45/45 invariants",
    "193 gate assertions",
    "viz-smoke",
    "viz_audit",
    "learning-system repository",
    "lives in a separate repository",
    "learning-system/infra/ACCESS.md",
)

violations = []
for rel in sorted(set(CURRENT)):
    path = ROOT / rel
    if not path.is_file():
        violations.append(f"{rel}: missing")
        continue
    for lineno, line in enumerate(path.read_text(errors="replace").splitlines(), 1):
        for token in BANNED:
            if token in line:
                violations.append(f"{rel}:{lineno}: {token}")

if not (ROOT / "docs/README.md").is_file():
    violations.append("docs/README.md: missing documentation index")

if violations:
    for v in violations:
        print(f"FAIL {v}")
    print(f"check-docs: {len(violations)} violation(s)")
    sys.exit(1)
print("check-docs: OK")
