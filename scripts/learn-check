#!/usr/bin/env bash
# learn-check — the single test entrypoint for the pi learning layer.
#
# Runs, in order:
#   1. gate behavior suite (test/gate_test.mjs, deno) — pure gate semantics
#   2. resources + contract coverage (test/contract/check_learning_layer.py)
#   3. load probe (test/contract/load_probe.py) — candidate pi loads the layer
#   4. py_compile of the learning-pi sidecars
#   5. optionally (--with-sidecars) the learning-system ops unittest suite,
#      read-only, against the real checkout
#
# Exit 0 only if every step passes. Used by harness/pi-safe-update to decide
# whether a candidate may be promoted.
#
# Usage:
#   scripts/learn-check [--with-sidecars] [--keep]
# Env:
#   LEARN_CHECK_PI     pi binary under test (default: <layer>/bin/pi)
#   LEARNING_PI_ROOT   layer root (default: parent of this script)
#   LEARNING_SYSTEM_ROOT  real checkout for --with-sidecars
set -uo pipefail

LAYER="${LEARNING_PI_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
PI_BIN="${LEARN_CHECK_PI:-$LAYER/bin/pi}"
WITH_SIDECARS=0
KEEP=0
NO_LOAD=0

for arg in "$@"; do
  case "$arg" in
    --with-sidecars) WITH_SIDECARS=1 ;;
    --no-load) NO_LOAD=1 ;;
    --keep) KEEP=1 ;;
    -h|--help)
      sed -n '2,20p' "$0"
      exit 0
      ;;
    *)
      echo "learn-check: unknown argument: $arg" >&2
      exit 2
      ;;
  esac
done

TMP="$(mktemp -d "${TMPDIR:-/tmp}/learn-check.XXXXXX")"
cleanup() { [ "$KEEP" = 1 ] || rm -rf "$TMP"; }
trap cleanup EXIT

FAILED=0
echo "learn-check: layer=$LAYER"
echo "learn-check: pi=$PI_BIN"
echo

# 1. behavior suites (gate + golden) --------------------------------------
: >"$TMP/gate.out"
if command -v deno >/dev/null 2>&1; then
  for suite in "$LAYER/test/gate_test.mjs" "$LAYER/test/golden/golden_test.mjs"; do
    name="$(basename "$suite")"
    out="$TMP/$name.out"
    if deno run --allow-all "$suite" >"$out" 2>&1; then
      if grep -q '^FAIL' "$out"; then
        echo "FAIL $name:"
        grep '^FAIL' "$out"
        FAILED=1
      else
        echo "PASS $name"
      fi
    else
      echo "FAIL $name (deno exited non-zero):"
      tail -20 "$out"
      FAILED=1
    fi
    cat "$out" >>"$TMP/gate.out"
  done
  echo "PASS gate behavior ($(grep -c '^PASS' "$TMP/gate.out") assertions total)"
else
  echo "FAIL behavior suites: deno not found"
  FAILED=1
fi

# 2. resources + contract coverage ---------------------------------------
if python3 "$LAYER/test/contract/check_learning_layer.py" "$LAYER" "$TMP/gate.out"; then
  :
else
  FAILED=1
fi

# 3. load probe -----------------------------------------------------------
if [ "$NO_LOAD" = 1 ]; then
  echo "SKIP load-probe (--no-load)"
elif SANDBOX="$(bash "$LAYER/harness/mk-sandbox.sh" --pi "$PI_BIN" --layer "$LAYER" 2>"$TMP/sandbox.err")"; then
  SANDBOX="$(printf '%s\n' "$SANDBOX" | tail -1)"
  if python3 "$LAYER/test/contract/load_probe.py" --sandbox "$SANDBOX" --pi "$PI_BIN"; then
    :
  else
    FAILED=1
  fi
else
  echo "FAIL load-probe: could not build sandbox"
  cat "$TMP/sandbox.err"
  FAILED=1
fi

# 4. py_compile sidecars --------------------------------------------------
shopt -s nullglob
PY_FILES=("$LAYER"/pi/*.py)
shopt -u nullglob
if [ "${#PY_FILES[@]}" -gt 0 ]; then
  if python3 -m py_compile "${PY_FILES[@]}" 2>"$TMP/pycompile.err"; then
    echo "PASS py_compile (${#PY_FILES[@]} learning-pi sidecars)"
  else
    echo "FAIL py_compile:"
    cat "$TMP/pycompile.err"
    FAILED=1
  fi
fi

# 5. optional sidecar suite (read-only, real checkout) --------------------
if [ "$WITH_SIDECARS" = 1 ]; then
  LS="${LEARNING_SYSTEM_ROOT:-$HOME/learning-system}"
  if [ -f "$LS/scripts/ops_test.py" ]; then
    if (cd "$LS" && python3 -m unittest scripts.ops_test) >"$TMP/ops.out" 2>&1; then
      echo "PASS ops_test (sidecar, read-only)"
    else
      echo "FAIL ops_test:"
      tail -25 "$TMP/ops.out"
      FAILED=1
    fi
  else
    echo "SKIP ops_test: no checkout at $LS"
  fi
fi

echo
if [ "$FAILED" = 0 ]; then
  echo "learn-check: OK"
  exit 0
fi
echo "learn-check: FAILED"
exit 1
